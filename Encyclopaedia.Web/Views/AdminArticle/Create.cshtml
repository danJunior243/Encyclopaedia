@model Encyclopaedia.Web.Models.ArticleCreateViewModel

@{
    ViewData["Title"] = "Nouvel article";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="admin-wrapper">

    <!-- ── TITRE ── -->
    <div class="admin-header">
        <h1 class="admin-title">Nouvel article</h1>
        <p class="admin-subtitle">Créer un nouvel article</p>
    </div>

    <form asp-action="Create" method="post">
        @if (!ViewData.ModelState.IsValid)
        {
            <div asp-validation-summary="All" class="login-error"></div>
        }
        <div class="admin-section">
            
            <div class="form-row">
                <div class="form-group">
                    <label asp-for="Title">Titre / Sujet</label>
                    <input asp-for="Title" type="text" id="article-subject" placeholder="Ex: La photosynthèse" />
                    <span asp-validation-for="Title" class="field-error"></span>
                </div>
                <div class="form-group">
                    <label asp-for="LanguageId">Langue</label>
                    <select asp-for="LanguageId" asp-items="Model.Languages">
                        <option value="">-- Choisir une langue --</option>
                    </select>
                    <span asp-validation-for="LanguageId" class="field-error"></span>
                </div>
            </div>

            <!-- Bouton IA -->
            <div style="margin-bottom:1.25rem;">
                <button type="button" class="btn-ai-generate" id="btn-generate" onclick="generateArticle()">
                    ✨ Générer avec IA
                </button>
                <span id="ai-status" style="font-size:0.82rem; color:var(--text-muted); margin-left:1rem;"></span>
            </div>

            <div class="form-group">
                <label asp-for="CategoryId">Catégorie</label>
                <select asp-for="CategoryId" asp-items="Model.Categories">
                    <option value="">-- Choisir une catégorie --</option>
                </select>
                <span asp-validation-for="CategoryId" class="field-error"></span>
            </div>

            <div class="form-group">
                <label asp-for="Summary">Résumé</label>
                <textarea asp-for="Summary" rows="3" placeholder="Bref résumé de l'article…"></textarea>
                <span asp-validation-for="Summary" class="field-error"></span>
            </div>

            <div class="form-group">
                <label asp-for="FeaturedImage">Image principale (URL)</label>
                <input asp-for="FeaturedImage" type="text" placeholder="https://images.unsplash.com/..." />
                <small style="color:var(--text-dim); font-size:0.78rem;">
                    Collez une URL d'image depuis Unsplash ou autre source libre de droits
                </small>
            </div>

            <div class="form-group">
                <label asp-for="Content">Contenu</label>
                <textarea asp-for="Content" id="content-editor" rows="12" placeholder="Contenu de l'article…"></textarea>
                <span asp-validation-for="Content" class="field-error"></span>
            </div>
        </div>

        <div style="display:flex; gap:1rem; justify-content:flex-end; margin-top:1rem;">
            <a asp-action="Index" class="btn-admin-cancel">Annuler</a>
            <button type="submit" class="btn-admin-add">Enregistrer</button>
        </div>

    </form>

</div>


@section Scripts {
    <script src="https://unpkg.com/tinymce@6/tinymce.min.js" referrerpolicy="origin"></script>
    <script>
        tinymce.init({
            selector: '#content-editor',
            height: 400,
            menubar: false,
            plugins: 'lists link image table code',
            toolbar: 'undo redo | bold italic underline | bullist numlist | link image table | code',
            content_style: 'body { font-family: Inter, sans-serif; font-size: 14px; }'
        });

               async function generateArticle() {
            const subject = document.getElementById('article-subject').value.trim();
            if (!subject) {
                alert('Veuillez entrer un sujet ou titre avant de générer.');
                return;
            }

            // Récupérer la langue choisie
            const langId = document.querySelector('[name="LanguageId"]').value;
            const langMap = { '1': 'fr', '2': 'en', '3': 'ar' };
            const lang = langMap[langId] || 'fr';

            const btn = document.getElementById('btn-generate');
            const status = document.getElementById('ai-status');
            btn.disabled = true;
            btn.textContent = '⏳ Génération en cours...';
            status.textContent = 'Claude rédige votre article...';

            try {
                const response = await fetch('/AdminArticle/GenerateWithAI', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ subject: subject, language: lang })
                });

                const data = await response.json();

                if (data.success) {
                    document.querySelector('[name="Summary"]').value = data.summary;
                    tinymce.get('content-editor').setContent(data.content);
                    if (data.imageUrl) {
                        document.querySelector('[name="FeaturedImage"]').value = data.imageUrl;
                    }
                    status.textContent = '✅ Article généré avec succès !';
                    status.style.color = 'green';
                } else {
                    status.textContent = '❌ Erreur : ' + data.error;
                    status.style.color = 'red';
                }
            } catch (error) {
                status.textContent = '❌ Erreur de connexion.';
                status.style.color = 'red';
            } finally {
                btn.disabled = false;
                btn.textContent = '✨ Générer avec IA';
            }
        }
    </script>
}