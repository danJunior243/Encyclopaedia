@{
    ViewData["Title"] = "À propos";
}

<!-- ── HERO ── -->
<section class="about-hero">
    <div class="about-hero-overlay"></div>
    <div class="about-hero-content">
        <h1 class="about-hero-title">À propos d'Encyclopædia</h1>
        <p class="about-hero-subtitle">Une encyclopédie de référence dédiée aux Sciences, à l'Histoire et à la Nature</p>
    </div>
</section>

<div class="article-page">

    <!-- ── MISSION ── -->
    <section class="about-section">
        <div class="about-grid">
            <div class="about-text">
                <h2 class="about-title">Notre mission</h2>
                <p class="about-desc">
                    Encyclopædia a pour mission de rendre la connaissance accessible à tous.
                    Nous croyons que l'éducation est un droit fondamental et que chaque personne
                    mérite d'avoir accès à des informations fiables, précises et bien rédigées.
                </p>
                <p class="about-desc">
                    Notre encyclopédie couvre trois grands domaines — les Sciences, l'Histoire et
                    la Nature — avec des articles rédigés avec rigueur et passion, vérifiés et
                    mis à jour régulièrement.
                </p>
            </div>
            <div class="about-image">
                <img src="https://images.unsplash.com/photo-1481627834876-b7833e8f5570?w=600&q=80" alt="Bibliothèque" />
            </div>
        </div>
    </section>

    <!-- ── VALEURS ── -->
    <section class="about-values">
        <h2 class="about-title" style="text-align:center; margin-bottom:2rem;">Nos valeurs</h2>
        <div class="values-grid">
            <div class="value-card">
                <div class="value-icon">🎯</div>
                <div class="value-name">Précision</div>
                <p class="value-desc">Chaque article est vérifié et basé sur des sources fiables.</p>
            </div>
            <div class="value-card">
                <div class="value-icon">🌍</div>
                <div class="value-name">Accessibilité</div>
                <p class="value-desc">Du contenu disponible en plusieurs langues pour tous.</p>
            </div>
            <div class="value-card">
                <div class="value-icon">📚</div>
                <div class="value-name">Richesse</div>
                <p class="value-desc">Des articles complets couvrant un large éventail de sujets.</p>
            </div>
            <div class="value-card">
                <div class="value-icon">🔄</div>
                <div class="value-name">Actualité</div>
                <p class="value-desc">Un contenu régulièrement mis à jour pour rester pertinent.</p>
            </div>
        </div>
    </section>

    <!-- ── STATISTIQUES ── -->
    <section class="about-stats">
        <div class="about-stats-grid">
            <div class="about-stat">
                <div class="about-stat-num">28+</div>
                <div class="about-stat-label">Articles</div>
            </div>
            <div class="about-stat">
                <div class="about-stat-num">3</div>
                <div class="about-stat-label">Domaines</div>
            </div>
            <div class="about-stat">
                <div class="about-stat-num">12</div>
                <div class="about-stat-label">Catégories</div>
            </div>
            <div class="about-stat">
                <div class="about-stat-num">3</div>
                <div class="about-stat-label">Langues</div>
            </div>
        </div>
    </section>

    <!-- ── CONTACT ── -->
    <section class="about-section">
        <h2 class="about-title">Nous contacter</h2>
        <p class="about-desc">
            Vous avez une suggestion, une correction ou souhaitez contribuer à l'encyclopédie ?
            N'hésitez pas à nous contacter.
        </p>
        <a href="mailto:contact@encyclopaedia.com" class="btn-admin-add" style="display:inline-block; margin-top:1rem;">
            📧 Nous écrire
        </a>
    </section>

</div>