@{
    ViewData["Title"] = "Mes favoris";
}

<div class="article-page">

    <!-- ── TITRE ── -->
    <div class="search-header">
        <h1 class="search-title">❤️ Mes favoris</h1>
        <p class="search-count" id="fav-count">Chargement...</p>
    </div>

    <!-- ── LISTE FAVORIS ── -->
    <div id="favorites-list" class="search-results"></div>

    <!-- ── VIDE ── -->
    <div id="favorites-empty" class="search-empty" style="display:none;">
        <div class="search-empty-icon">🤍</div>
        <p>Vous n'avez pas encore de favoris.</p>
        <p class="search-empty-hint">Cliquez sur ❤️ sur un article pour l'ajouter !</p>
        <a asp-controller="Articles" asp-action="Index" class="btn-admin-add" style="display:inline-block; margin-top:1rem;">
            Explorer les articles
        </a>
    </div>

</div>

@section Scripts {
    <script>
        // Charger les favoris depuis localStorage
        const favorites = JSON.parse(localStorage.getItem('favorites') || '[]');
        const list = document.getElementById('favorites-list');
        const empty = document.getElementById('favorites-empty');
        const count = document.getElementById('fav-count');

        if (favorites.length === 0) {
            empty.style.display = 'block';
            count.textContent = '0 article(s) en favoris';
        } else {
            count.textContent = favorites.length + ' article(s) en favoris';
            favorites.forEach(fav => {
                const card = document.createElement('a');
                card.href = '/article/' + fav.slug;
                card.className = 'search-result-card';
                card.style.display = 'block';
                card.innerHTML = `
                    <div class="search-result-meta">
                        <span>❤️ Favori</span>
                    </div>
                    <h2 class="search-result-title">${fav.title}</h2>
                    <span class="search-result-link">Lire l'article →</span>
                `;
                list.appendChild(card);
            });
        }
    </script>
}