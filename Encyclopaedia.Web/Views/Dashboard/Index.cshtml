@model Encyclopaedia.Web.Models.DashboardViewModel

@{
    ViewData["Title"] = "Dashboard";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="admin-wrapper">

    <!-- ── TITRE ── -->
    <div class="admin-header">
        <h1 class="admin-title">Dashboard</h1>
        <p class="admin-subtitle">Vue d'ensemble de l'encyclopédie</p>
    </div>

    <!-- ── STATISTIQUES ── -->
    <div class="stats-grid">
        <div class="stat-card">
            <div class="stat-number">@Model.TotalArticles</div>
            <div class="stat-label">Total articles</div>
        </div>
        <div class="stat-card">
            <div class="stat-number">@(Model.ArticlesByStatus.ContainsKey(Encyclopaedia.Core.Enums.ArticleStatus.Published) ? Model.ArticlesByStatus[Encyclopaedia.Core.Enums.ArticleStatus.Published] : 0)</div>
            <div class="stat-label">Publiés</div>
        </div>
        <div class="stat-card">
            <div class="stat-number">@(Model.ArticlesByStatus.ContainsKey(Encyclopaedia.Core.Enums.ArticleStatus.Draft) ? Model.ArticlesByStatus[Encyclopaedia.Core.Enums.ArticleStatus.Draft] : 0)</div>
            <div class="stat-label">Brouillons</div>
        </div>
        <div class="stat-card">
            <div class="stat-number">@(Model.ArticlesByStatus.ContainsKey(Encyclopaedia.Core.Enums.ArticleStatus.Review) ? Model.ArticlesByStatus[Encyclopaedia.Core.Enums.ArticleStatus.Review] : 0)</div>
            <div class="stat-label">En révision</div>
        </div>
    </div>

    <!-- ── ARTICLES RÉCEMMENT MIS À JOUR ── -->
    <div class="admin-section">
        <h2 class="admin-section-title">Récemment mis à jour</h2>
        <table class="admin-table">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Catégorie</th>
                    <th>Statut</th>
                    <th>Mis à jour</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var article in Model.RecentlyUpdated)
                {
                    <tr>
                        <td>@article.ArticleId</td>
                        <td>@article.Category?.Slug</td>
                        <td>@article.Statut</td>
                        <td>@article.LastUpdatedAt.ToString("dd/MM/yyyy")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- ── GRAPHIQUES ── -->
    <div class="stats-charts">
        <div class="admin-section">
            <h2 class="admin-section-title">Articles par domaine</h2>
            <canvas id="domainChart" height="200"></canvas>
        </div>
        <div class="admin-section">
            <h2 class="admin-section-title">Articles par statut</h2>
            <canvas id="statusChart" height="200"></canvas>
        </div>
    </div>

    <!-- ── TRADUCTION EN MASSE ── -->
    <div class="admin-section">
        <h2 class="admin-section-title">Traduction en masse</h2>
        <p style="font-size:0.85rem; color:#666; margin-bottom:1rem;">
            Traduit automatiquement tous les articles non traduits via Claude IA.
        </p>
        <div style="display:flex; gap:1rem;">
            <button onclick="translateAll('en')" class="btn-admin-add">
                🇬🇧 Traduire tout en anglais
            </button>
            <button onclick="translateAll('ar')" class="btn-admin-add">
                🇸🇦 Traduire tout en arabe
            </button>
        </div>
        <div id="translate-status" style="margin-top:1rem; font-size:0.85rem;"></div>
    </div>


</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        // Graphique par domaine
        new Chart(document.getElementById('domainChart'), {
            type: 'bar',
            data: {
                labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.DomainLabels)),
                datasets: [{
                    label: 'Articles',
                    data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.DomainData)),
                    backgroundColor: ['#2A6099', '#8B2635', '#2D6A4F'],
                    borderRadius: 6
                }]
            },
            options: {
                responsive: true,
                plugins: { legend: { display: false } },
                scales: { y: { beginAtZero: true } }
            }
        });

        // Graphique par statut
        new Chart(document.getElementById('statusChart'), {
            type: 'doughnut',
            data: {
                labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.StatusLabels)),
                datasets: [{
                    data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.StatusData)),
                    backgroundColor: ['#6B6B6B', '#856404', '#0a3622', '#842029'],
                    borderWidth: 0
                }]
            },
            options: {
                responsive: true,
                plugins: { legend: { position: 'bottom' } }
            }
        });

        async function translateAll(lang) {
            const langName = lang === 'en' ? 'anglais' : 'arabe';
            if (!confirm(`Traduire tous les articles non traduits en ${langName} ? Cela peut prendre plusieurs minutes.`)) return;

            const status = document.getElementById('translate-status');
            status.textContent = '⏳ Traduction en cours... Veuillez patienter.';
            status.style.color = 'orange';

            try {
                const response = await fetch('/Admin/Dashboard/TranslateAll', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ targetLang: lang })
                });

                const data = await response.json();

                if (data.success) {
                    status.textContent = `✅ ${data.message}`;
                    status.style.color = 'green';
                } else {
                    status.textContent = `❌ Erreur : ${data.error}`;
                    status.style.color = 'red';
                }
            } catch (error) {
                status.textContent = '❌ Erreur de connexion.';
                status.style.color = 'red';
            }
        }



    </script>
}